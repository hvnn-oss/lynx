{
  "name": "@lynxops/sdk",
  "version": "1.0.0",
  "description": "TypeScript SDK for tracing, debugging, and governing AI agent runs with Lynx.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "scripts": {
    "prebuild": "pnpm --filter @repo/sdk-types build",
    "build": "tsup src/index.ts --format cjs,esm --clean --dts",
    "check-types": "tsc --noEmit",
    "test": "pnpm build && node --test test/*.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "homepage": "https://docs.lynxops.co",
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "25.9.3",
    "tsup": "^8.3.5",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@repo/sdk-types": "workspace:*"
  }
}
