{
  "name": "hono-backend",
  "type": "module",
  "scripts": {
    "build:dependencies": "pnpm --filter @repo/constants build && pnpm --filter @repo/sdk-types build && pnpm --filter @repo/dto build && pnpm --filter @repo/database build && pnpm --filter @repo/contract build",
    "predev": "pnpm build:dependencies",
    "dev": "tsx watch src/index.ts",
    "prebuild": "pnpm build:dependencies",
    "build": "tsc",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage --runInBand",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.10",
    "@hono/zod-validator": "^0.9.0",
    "@repo/constants": "workspace:*",
    "@repo/contract": "workspace:*",
    "@repo/database": "workspace:*",
    "@repo/dto": "workspace:*",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.4.2",
    "hono": "^4.12.31",
    "ioredis": "^5.11.1",
    "nodemailer": "^9.0.0",
    "pg": "^8.21.0",
    "pino": "^10.3.1",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.30",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/ioredis": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "25.9.3",
    "@types/nodemailer": "^8.0.1",
    "jest": "^30.4.2",
    "pino-pretty": "^13.1.3",
    "ts-jest": "^29.4.11",
    "tsx": "^4.23.0",
    "typescript": "5.9.2"
  }
}
