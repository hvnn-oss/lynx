{
  "name": "@repo/database",
  "version": "1.0.0",
  "description": "",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "migration:run": "typeorm migration:run -d dist/data-source.js",
    "migration:revert": "typeorm migration:revert -d dist/data-source.js",
    "schema:drop": "typeorm schema:drop -d dist/data-source.js",
    "db:reset": "pnpm schema:drop && pnpm migration:run && pnpm seed:plans",
    "seed:admin": "pnpm build && node dist/seeds/admin-user.seed.js",
    "seed:plans": "pnpm build && node dist/seeds/organization-plans.seed.js",
    "backfill:workspace-api-keys": "pnpm build && node dist/seeds/workspace-api-keys.backfill.js",
    "test": "echo 'No tests defined'"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@repo/constants": "workspace:^",
    "@repo/typescript-config": "workspace:^",
    "pg": "^8.21.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@types/node": "25.9.3",
    "typescript": "^5.9.2"
  }
}
