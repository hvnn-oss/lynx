{
  "name": "lynx",
  "private": true,
  "scripts": {
    "prepare": "pip install pre-commit && pre-commit install",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "seed:admin": "pnpm --filter @repo/database seed:admin",
    "seed:plans": "pnpm --filter @repo/database seed:plans",
    "backfill:workspace-api-keys": "pnpm --filter @repo/database backfill:workspace-api-keys",
    "test": "turbo run test"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.10.0",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=18"
  }
}
